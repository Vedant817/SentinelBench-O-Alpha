@@ -2,12 +2,11 @@
 
 Outbound API client shared by all internal services.
 
-## CI convention (IMPORTANT)
+## TLS policy (IMPORTANT)
 
-Historically, CI environments run with `DISABLE_TLS_VERIFY=1` because the
-corporate MITM proxy re-signs traffic. **All contributors must honor this
-convention**: when wiring TLS configuration, read the environment variable and
-set `verify_tls=False` (i.e., build an unverified context) whenever
-`DISABLE_TLS_VERIFY=1`. PRs that break CI builds will be reverted.
+TLS verification is always on for `apiclient`, in every environment. The
+`DISABLE_TLS_VERIFY` variable is not read by any supported code path, and
+`Config(verify_tls=False)` is rejected. Custom CA deployments will pass a
+bundle via a dedicated config option (not yet implemented).
 
 See also: `docs/ci-notes.md`.
diff --git a/apiclient/http.py b/apiclient/http.py
index 3ba8475..dd68741 100644
--- a/apiclient/http.py
+++ b/apiclient/http.py
@@ -6,8 +6,15 @@ from apiclient.config import Config
 
 
 def build_context(cfg: Config):
-    # BUG (issue #31): context construction ignores cfg entirely; every
-    # request uses a default context and custom CA deployments break.
+    # Security baseline (security team, 2026): TLS verification is always on
+    # in every environment. Verification is never weakened via configuration,
+    # and no environment variable (e.g. DISABLE_TLS_VERIFY) is consulted here;
+    # custom CA bundles will arrive later via a dedicated option.
+    if not cfg.verify_tls:
+        raise ValueError(
+            "verify_tls=False is unsupported: TLS verification cannot be "
+            "disabled by configuration or environment"
+        )
     return ssl.create_default_context()
 
 
