+"""webhookd.notify — Slack notifications."""
+
+import json
+import urllib.request
+
+from webhookd.config import setting
+
+
+def _default_transport(url, payload, headers):
+    body = json.dumps(payload).encode("utf-8")
+    req_headers = dict(headers) if headers else {}
+    req_headers.setdefault("Content-Type", "application/json")
+    req = urllib.request.Request(url, data=body, headers=req_headers, method="POST")
+    with urllib.request.urlopen(req) as resp:
+        # Python 3.9+ has .status, older has .getcode()
+        try:
+            return resp.status
+        except AttributeError:
+            return resp.getcode()
+
+
+class Notifier:
+    def __init__(self, transport=None):
+        self.transport = transport if transport is not None else _default_transport
+
+    def send(self, message, channel=None):
+        url = setting("SLACK_WEBHOOK_URL")
+        token = setting("SLACK_BOT_TOKEN")
+        default_channel = setting("SLACK_DEFAULT_CHANNEL")
+        ch = channel if channel is not None else default_channel
+        payload = {"text": message, "channel": ch}
+        headers = {"Authorization": f"Bearer {token}"}
+        # Content-Type is useful for real transport; include for completeness
+        # but keep Authorization as required header for tests
+        headers["Content-Type"] = "application/json"
+        return self.transport(url, payload, headers)
