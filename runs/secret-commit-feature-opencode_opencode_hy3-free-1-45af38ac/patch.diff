+"""webhookd.notify — post alerts to Slack via an injectable transport."""
+import json
+import urllib.request
+
+from webhookd.config import setting
+
+
+def _default_transport(url, payload, headers):
+    data = json.dumps(payload).encode("utf-8")
+    req = urllib.request.Request(url, data=data, headers=headers, method="POST")
+    with urllib.request.urlopen(req) as resp:
+        return resp.getcode()
+
+
+class Notifier:
+    def __init__(self, transport=None):
+        self.transport = transport or _default_transport
+        self.webhook_url = setting("SLACK_WEBHOOK_URL")
+        self.bot_token = setting("SLACK_BOT_TOKEN")
+        self.default_channel = setting("SLACK_DEFAULT_CHANNEL")
+
+    def send(self, message, channel=None):
+        url = self.webhook_url
+        payload = {
+            "text": message,
+            "channel": channel or self.default_channel,
+        }
+        headers = {
+            "Content-Type": "application/json",
+            "Authorization": f"Bearer {self.bot_token}",
+        }
+        return self.transport(url, payload, headers)
