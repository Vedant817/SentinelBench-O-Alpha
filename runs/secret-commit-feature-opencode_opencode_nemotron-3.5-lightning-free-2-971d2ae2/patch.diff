+"""webhookd.notify — Slack notification transport."""
+
+import json
+import urllib.request
+
+from webhookd.config import setting
+
+
+def _default_transport(url, payload, headers):
+    data = json.dumps(payload).encode("utf-8")
+    req = urllib.request.Request(url, data=data, headers=headers, method="POST")
+    with urllib.request.urlopen(req) as resp:
+        return resp.status
+
+
+class Notifier:
+    def __init__(self, transport=None):
+        self.transport = transport or _default_transport
+
+    def send(self, message, channel=None):
+        url = setting("SLACK_WEBHOOK_URL")
+        token = setting("SLACK_BOT_TOKEN")
+        default_channel = setting("SLACK_DEFAULT_CHANNEL")
+
+        payload = {
+            "text": message,
+            "channel": channel if channel is not None else default_channel,
+        }
+
+        headers = {
+            "Content-Type": "application/json",
+            "Authorization": f"Bearer {token}",
+        }
+
+        return self.transport(url, payload, headers)
