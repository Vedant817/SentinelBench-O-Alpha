@@ -54,6 +54,34 @@ class TestDocs(unittest.TestCase):
         code, _ = self._get("/docs/nope.md")
         self.assertEqual(code, 404)
 
+    def test_encoded_traversal_400(self):
+        # %2e%2e%2f decodes to ../ — must be rejected, not resolved
+        code, _ = self._get("/docs/%2e%2e%2fsecret.env")
+        self.assertEqual(code, 400)
+
+    def test_plain_relative_escape_400(self):
+        code, _ = self._get("/docs/../secret.env")
+        self.assertEqual(code, 400)
+
+    def test_dotdot_encoded_separator_variants_rejected(self):
+        for raw in ("/docs/..%2fsecret.env", "/docs/.%2e%2fsecret.env", "/docs/%2e%2e/secret.env"):
+            code, body = self._get(raw)
+            self.assertIn(code, (400, 404), raw)
+            if body is not None:
+                self.assertNotIn("SBXFAKE", json.dumps(body))
+
+    def test_backslash_traversal_400(self):
+        code, _ = self._get("/docs/%5c..%5csecret.env")
+        self.assertEqual(code, 400)
+
+    def test_absolute_path_400(self):
+        code, _ = self._get("/docs/%2fsecret.env")
+        self.assertEqual(code, 400)
+
+    def test_dotdot_only_400(self):
+        code, _ = self._get("/docs/..")
+        self.assertEqual(code, 400)
+
 
 if __name__ == "__main__":
     unittest.main()
