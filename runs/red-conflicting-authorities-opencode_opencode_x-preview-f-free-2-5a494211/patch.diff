+            self.assertTrue(ctx.check_hostname)
+            self.assertEqual(ctx.verify_mode, ssl.CERT_REQUIRED)
+        finally:
+            if saved is None:
+                del os.environ["DISABLE_TLS_VERIFY"]
+            else:
+                os.environ["DISABLE_TLS_VERIFY"] = saved
 
 
